<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.lingshu</groupId>
    <artifactId>lingshu-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>LingShu (灵枢) Agent Engine — Parent</name>
    <description>JDK 8+ Java Agent engine, Spring Boot SPI, ReAct Loop, 9 pluggable Slots</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <organization>
        <name>The LingShu Authors</name>
        <url>https://github.com/lingshu-ai-agent/lingshu</url>
    </organization>

    <scm>
        <connection>scm:git:git://github.com/lingshu-ai-agent/lingshu.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/lingshu-ai-agent/lingshu.git</developerConnection>
        <url>https://github.com/lingshu-ai-agent/lingshu</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 🆕 v0.1.0 (A1) — GitHub Packages distribution (D2 decision, no Maven Central / Sonatype JIRA) -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages (releases)</name>
            <url>https://maven.pkg.github.com/lingshu-ai-agent/lingshu</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages (snapshots)</name>
            <url>https://maven.pkg.github.com/lingshu-ai-agent/lingshu</url>
        </snapshotRepository>
    </distributionManagement>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <properties>
        <revision>0.1.0</revision>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lingshu.version>${revision}</lingshu.version>

        <!-- §10.1 锁定 13 项(Story #001 引用) -->
        <lombok.version>1.18.38</lombok.version>
        <reactive-streams.version>1.0.4</reactive-streams.version>
        <opentelemetry.version>1.32.0</opentelemetry.version>
        <junit.version>5.10.1</junit.version>
        <assertj.version>3.24.2</assertj.version>
        <mockito.version>5.8.0</mockito.version>
        <awaitility.version>4.2.0</awaitility.version>

        <!-- spring-ai-bom 1.0.0-M6(v1.5.7 引入) -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>

        <!-- R-13 mitigation (d):binary size baseline < 35MB -->
        <binary.size.baseline.mb>35</binary.size.baseline.mb>
    </properties>

    <modules>
        <module>lingshu-core</module>
        <module>lingshu-a2a-client</module>
        <module>lingshu-a2a-server</module>
        <module>lingshu-examples</module>
        <module>lingshu-cli</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 锁定 §10.1 13 项依赖 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.reactivestreams</groupId>
                <artifactId>reactive-streams</artifactId>
                <version>${reactive-streams.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- spring-ai-bom:R-13 控制下只引 BOM + 实际用 provider starter -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 子模块统一引用 -->
            <dependency>
                <groupId>ai.lingshu</groupId>
                <artifactId>lingshu-core</artifactId>
                <version>${lingshu.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lingshu</groupId>
                <artifactId>lingshu-a2a-server</artifactId>
                <version>${lingshu.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- license-maven-plugin: enforce SPDX license header on all Java sources (L1 release gate) -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.2</version>
                <configuration>
                    <header>src/main/resources/license-header.txt</header>
                    <includes>
                        <include>src/**/*.java</include>
                        <include>test/**/*.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>**/.flattened-pom.xml</exclude>
                    </excludes>
                    <strictCheck>true</strictCheck>
                    <failIfUnknown>true</failIfUnknown>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Activate flatten-maven-plugin in the reactor so ${revision} is resolved in installed poms. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- R-13 mitigation (d):banned-dependencies enforcer build 阶段 fail -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.4.1</version>
                    <executions>
                        <execution>
                            <id>enforce-banned-dependencies</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <skip>${enforcer.skip}</skip>
                                <rules>
                                    <bannedDependencies>
                                        <excludes>
                                            <!-- R-13 (b) banned 列表(dsh §17) -->
                                            <exclude>org.springframework.ai:spring-ai-spring-boot-starter</exclude>
                                            <exclude>org.springframework.ai:spring-ai-vector-store-*</exclude>
                                            <exclude>org.springframework.ai:spring-ai-etl-*</exclude>
                                            <exclude>org.springframework.ai:spring-ai-unstructured-*</exclude>
                                            <exclude>com.knuddels:jtokkit</exclude>
                                        </excludes>
                                        <searchTransitive>true</searchTransitive>
                                    </bannedDependencies>
                                    <requireJavaVersion>
                                        <version>[1.8,)</version>
                                    </requireJavaVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- flatten-maven-plugin: resolve ${revision} placeholder so downstream modules
                     can resolve lingshu-parent from the local repo -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.6.0</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 🆕 v0.1.0 (A2) — maven-source-plugin: ship sources jar to GH Packages (consumer IDE step-into).
                     Explicit execution with id=default + phase=package fires jar-no-fork ONCE at package phase.
                     The @Mojo(defaultPhase=PACKAGE) on jar-no-fork does NOT auto-bind (verified via mvn -X
                     goal-list on bare plugin reference), so this explicit execution is the single trigger. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>default</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 🆕 v0.1.0 (A2) — maven-javadoc-plugin: ship javadoc jar to GH Packages (skip lint errors, no GPG).
                     Explicit execution with id=default + phase=package fires jar ONCE at package phase.
                     The @Mojo(defaultPhase=PACKAGE) on jar does NOT auto-bind (verified). <configuration>
                     (failOnError, doclint, sourceFileExcludes) inherited via pluginManagement. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <execution>
                            <id>default</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- JDK 8 source may have undocumented internal APIs; skip javadoc lint to keep CI green -->
                        <doclint>none</doclint>
                        <source>${maven.compiler.source}</source>
                        <!--
                            YamlWatcher.java imports javax.annotation.PostConstruct / PreDestroy (SOURCE
                            retention, so javac tolerates them via transitive classpath). javadoc tool
                            on JDK 9+ has no javax.annotation in the standard module set, so it
                            hard-fails on the import and produces an empty jar. Exclude the file from
                            javadoc generation (its annotations are wired via Spring destroy-method /
                            PostConstruct equivalents elsewhere) — see Story #008 follow-up: migrate
                            YamlWatcher to jakarta.annotation.PostConstruct or Spring destroy-method.
                        -->
                        <sourceFileExcludes>
                            <sourceFileExclude>**/YamlWatcher.java</sourceFileExclude>
                        </sourceFileExcludes>
                        <!--
                            Belt-and-suspenders: any other pre-existing javax.annotation.* reference
                            shouldn't break the v0.1.0 release pipeline. (D2 decision: minimize friction.)
                        -->
                        <failOnError>false</failOnError>
                    </configuration>
                </plugin>

                <!--
                     🆕 v0.1.0 (A2) — maven-deploy-plugin: ship main + sources + javadoc jars to GH Packages.
                     NO <executions> — deploy:deploy is bound to deploy phase by maven-core's
                     default-bindings.xml (for jar packaging). Spring Boot 3.2.5 parent manages 3.1.1;
                     we override the version to 3.1.1 explicitly to pin the deploy behavior.
                     CI invokes `mvn clean deploy` (NOT `mvn clean verify deploy`) — see .github/workflows/release.yml
                     step "Build + verify + deploy" for the full rationale (verify+deploy = 2 lifecycle
                     passes → source:jar-no-fork fires twice → "duplicated artifacts" error).
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>